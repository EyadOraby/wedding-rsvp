generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("POSTGRES_PRISMA_URL")
  directUrl = env("POSTGRES_URL_NON_POOLING")
}

model SiteSettings {
  id             String   @id @default("default")
  initials       String   @default("A & S")
  coupleNames    String   @default("ALEX & SAM")
  weddingDate    String   @default("SATURDAY, JUNE 12, 2027")
  location       String   @default("CAIRO, EGYPT")
  heroImageUrl   String?
  rsvpHeading    String   @default("RSVP")
  bankingHeading String   @default("GIFTING")
  updatedAt      DateTime @updatedAt
}

model MealOption {
  id          String  @id @default(cuid())
  title       String
  description String
  tag         String?
  sortOrder   Int     @default(0)
  active      Boolean @default(true)
  rsvps       Rsvp[]
}

model DietaryOption {
  id        String  @id @default(cuid())
  label     String
  sortOrder Int     @default(0)
  active    Boolean @default(true)
}

model BankingInfo {
  id            String   @id @default("default")
  accountName   String
  bankName      String
  accountNumber String
  branchCode    String
  notes         String?
  active        Boolean  @default(true)
  updatedAt     DateTime @updatedAt
}

model Rsvp {
  id            String      @id @default(cuid())
  guestName     String
  email         String?
  attending     Boolean
  guestCount    Int         @default(1)
  mealOptionId  String?
  mealOption    MealOption? @relation(fields: [mealOptionId], references: [id], onDelete: SetNull)
  dietaryLabels String[]
  dietaryOther  String?
  message       String?
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
}

// RSVP builder: users create events, guests reply to them.

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  name         String
  passwordHash String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  events       Event[]
}

model Event {
  id        String   @id @default(cuid())
  ownerId   String
  owner     User     @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  slug      String   @unique
  type      String
  title     String
  published Boolean  @default(false)
  /// Details, theme, sections and RSVP questions; see src/lib/events/content.ts
  content   Json
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  replies   Reply[]

  @@index([ownerId])
}

model Reply {
  id         String   @id @default(cuid())
  eventId    String
  event      Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  name       String
  email      String?
  attending  Boolean
  guestCount Int
  message    String?
  /// Answers keyed by question id; see src/lib/events/answers.ts
  answers    Json     @default("{}")
  createdAt  DateTime @default(now())

  @@index([eventId, createdAt])
}
