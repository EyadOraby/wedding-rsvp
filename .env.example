# Copy this file to `.env` and fill in the values.
# Both Next.js and the Prisma CLI read `.env`.

# Postgres connection strings (Neon, Supabase, Vercel Postgres, or local Docker).
# Pooled URL used by the app at runtime:
POSTGRES_PRISMA_URL="postgresql://USER:PASSWORD@HOST:5432/DB?sslmode=require&pgbouncer=true"
# Direct (non-pooled) URL used by Prisma for schema changes:
POSTGRES_URL_NON_POOLING="postgresql://USER:PASSWORD@HOST:5432/DB?sslmode=require"


# Signs admin session cookies. At least 32 random characters, e.g.:
#   openssl rand -base64 48
# Changing it signs everyone out.
SESSION_SECRET=""

# Optional: password for the demo host that `npm run db:seed` creates
# (demo@example.com). A random one is printed if this is empty.
DEMO_PASSWORD=""

# Optional: email through Resend (https://resend.com). Without a key, no email
# is sent and everything else works the same.
RESEND_API_KEY=""
# Sender, e.g. "RSVP Studio <rsvp@yourdomain.com>" once your domain is
# verified in Resend. Leave empty to use onboarding@resend.dev, which only
# delivers to the email address of your own Resend account.
EMAIL_FROM=""
